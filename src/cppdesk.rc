    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CppDesk"
            VALUE "FileDescription", "CppDesk Ultra-Low-Latency Remote Desktop"
            VALUE "FileVersion", "3.7.0.0"
            VALUE "InternalName", "CppDesk"
            VALUE "OriginalFilename", "CppDesk.exe"
            VALUE "ProductName", "CppDesk"
            VALUE "ProductVersion", "3.7.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
